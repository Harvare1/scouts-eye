scouts-eye.knegare.eu {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer-when-downgrade
	}

	reverse_proxy {
		to 82.197.73.183:8090 207.2.123.192:8090

		health_uri /health
		health_interval 10s
		health_timeout 2s

		lb_policy least_conn
		lb_try_duration 3s
		lb_try_interval 250ms

		transport http {
			dial_timeout 1s
			response_header_timeout 10s
			read_timeout 10s
			write_timeout 10s
			keepalive 30s
		}
	}
}

